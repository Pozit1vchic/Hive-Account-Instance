<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hive.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" x:Class="Hive.App.MainWindow" FontSize="13" Title="Hive" Width="900" Height="560" MinWidth="860" MinHeight="540" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" local:Motion.Enabled="{Binding EffectiveMotion}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource CanvasBrush}" CornerRadius="10">
 <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
   <Grid Margin="20,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="28" Height="30" Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Margin="0,0,9,0"><local:SvgIcon NameKey="hex" Width="21" Height="21" Foreground="{DynamicResource AccentInkBrush}"/></Border><TextBlock Text="Hive" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Width="1" Height="17" Margin="18,0" Background="{DynamicResource LineBrush}"/><TextBlock Text="Accounts" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Style="{StaticResource IconButton}" Click="OpenSettings" ToolTip="Settings" AutomationProperties.Name="Settings" Margin="0,0,15,0"><local:SvgIcon NameKey="settings" Width="17" Height="17"/></Button>
     <Button Style="{StaticResource IconButton}" Click="MinimizeWindow" AutomationProperties.Name="Minimize"><local:SvgIcon NameKey="minimize" Width="16" Height="16"/></Button><Button Style="{StaticResource IconButton}" Click="MaximizeWindow" AutomationProperties.Name="Maximize"><local:SvgIcon NameKey="maximize" Width="16" Height="16"/></Button><Button Style="{StaticResource IconButton}" Click="CloseWindow" AutomationProperties.Name="Close"><local:SvgIcon NameKey="close" Width="16" Height="16"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><local:HoneycombBackdrop Width="420" Height="145" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.35" IsHitTestVisible="False"/>
   <Grid x:Name="Workspace" Margin="24,20,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,17"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanEdit}"><Button Click="ShowGroups" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:SvgIcon NameKey="group" Width="15" Height="15"/><TextBlock Text="{Binding GroupLabel}" MaxWidth="80" TextTrimming="CharacterEllipsis" Margin="7,0,0,0"/></StackPanel></Button><Button Click="ShowTools" Margin="0,0,8,0" ToolTip="Utilities" AutomationProperties.Name="Utilities"><local:SvgIcon NameKey="utility" Width="16" Height="16"/></Button><Button Click="EditSelected" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:SvgIcon NameKey="user" Width="16" Height="16"/><TextBlock Text="Edit" Margin="7,0,0,0"/></StackPanel></Button><Button Command="{Binding OpenBrowserCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:SvgIcon NameKey="browser" Width="16" Height="16"/><TextBlock Text="Open browser" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button><Button Click="ShowAddMenu" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><local:SvgIcon NameKey="plus" Width="16" Height="16"/><TextBlock Text="Add account" Margin="7,0,0,0" VerticalAlignment="Center"/><local:SvgIcon NameKey="chevron-down" Width="12" Height="12" Margin="9,0,0,0"/></StackPanel></Button></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="Accounts" FontSize="22" FontWeight="SemiBold"/></StackPanel></DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="256"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding AllFilterCommand}" Margin="0,0,5,0" Padding="11,7"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding FilterMode}" Value="All"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="All accounts"/><TextBlock Text="{Binding TotalCount}" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0"/></StackPanel></Button><Button Click="ShowFavorites" Margin="0,0,5,0" Padding="11,7"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding FilterMode}" Value="Favorites"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><local:SvgIcon NameKey="star" Width="13" Height="13"/><TextBlock Text="Favorites" Margin="6,0,0,0"/></StackPanel></Button><Button Command="{Binding RunningFilterCommand}" Margin="0,0,5,0" Padding="11,7"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding FilterMode}" Value="Running"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="Running"/><TextBlock Text="{Binding RunningCount}" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0"/></StackPanel></Button><Button Command="{Binding AttentionFilterCommand}" Margin="0,0,5,0" Padding="11,7"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding FilterMode}" Value="Attention"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="Needs sign-in"/><TextBlock Text="{Binding AttentionCount}" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0"/></StackPanel></Button></StackPanel><Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><DockPanel Margin="10,0,0,0"><local:SvgIcon NameKey="search" Width="15" Height="15" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Left"/><Grid><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="Search accounts" Padding="9,8"/><TextBlock Text="Search accounts..." Foreground="{DynamicResource MutedBrush}" Margin="10,8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border></Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Grid Margin="1,9,1,0"><DataGrid x:Name="AccountsTable" MouseDoubleClick="EditSelected" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanEdit}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource LineBrush}" Background="Transparent" Foreground="{DynamicResource InkBrush}" BorderThickness="0" RowHeight="{Binding TableRowHeight}" ColumnHeaderHeight="34" SelectionMode="Extended" SelectionUnit="FullRow" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MinColumnWidth="40">
       <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Open browser" Command="{Binding OpenBrowserCommand}"/><MenuItem Header="Toggle favorite" Click="ToggleFavorite"/><MenuItem Header="Move to group..." Click="ShowMoveGroups"/><MenuItem Header="Copy username" Click="CopyUsername"/><Separator/><MenuItem Header="Remove account" Command="{Binding DeleteCommand}"/></ContextMenu></DataGrid.ContextMenu>
       <DataGrid.Resources>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="14,0"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><DataGridCellsPresenter SnapsToDevicePixels="True"/></Border></ControlTemplate></Setter.Value></Setter><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsInvalid}" Value="True"><Setter Property="Foreground" Value="{DynamicResource RedBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="13,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=DataGridRow}}"/></Trigger></Style.Triggers></Style>
       </DataGrid.Resources>
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Account name" Width="1.25*" SortMemberPath="Username"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding StateLabel}"><local:SvgIcon NameKey="star" Width="13" Height="13" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}"><local:SvgIcon.Style><Style TargetType="local:SvgIcon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:SvgIcon.Style></local:SvgIcon><Ellipse Width="4" Height="4" Margin="0,0,9,0" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=DataGridRow}}"/><TextBlock Text="{Binding Username}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Password" Binding="{Binding PasswordText}" Width="0.75*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        <DataGridTextColumn Header="Description" Binding="{Binding Notes}" Width="1.2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Notes}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><local:SvgIcon NameKey="users" Width="30" Height="30" Foreground="{DynamicResource MutedBrush}" Opacity="0.5" Margin="0,0,0,14"/><TextBlock Text="No accounts here yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Add an account or change your filter." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Grid>
      <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,0"><DockPanel><TextBlock Text="{Binding Count,StringFormat={}{0} accounts}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource GreenBrush}" Width="5" Height="5" Margin="0,0,6,0"/><TextBlock Text="Running" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><Ellipse Fill="{DynamicResource RedBrush}" Width="5" Height="5" Margin="14,0,6,0"/><TextBlock Text="Sign-in required" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel></DockPanel></Border>
     </Grid></Border>

    </Grid>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><DockPanel><Button DockPanel.Dock="Right" Click="ShowSavedPlaces" Style="{StaticResource IconButton}" MinHeight="20" Height="20" Padding="2" MinWidth="24" ToolTip="Saved places"><local:SvgIcon NameKey="save" Width="13" Height="13"/></Button><Label Content="Place ID"/></DockPanel><TextBox Text="{Binding PlaceId,UpdateSourceTrigger=PropertyChanged}" Height="33" AutomationProperties.Name="Place ID"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,14,0"><Label Content="Job ID (optional)"/><TextBox Text="{Binding JobId,UpdateSourceTrigger=PropertyChanged}" Height="33" AutomationProperties.Name="Job ID"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding LaunchStatus}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" Margin="0,10,15,0"/><Button Grid.Column="3" Click="LaunchSelectedAccounts" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasSelection}" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal"><local:SvgIcon NameKey="play" Width="15" Height="15"/><TextBlock Text="Launch selected" Margin="7,0,0,0"/></StackPanel></Button></Grid></Border>
   </Grid>
   <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="12,6"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal"><local:SvgIcon NameKey="refresh" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5"><local:SvgIcon.RenderTransform><RotateTransform/></local:SvgIcon.RenderTransform><local:SvgIcon.Style><Style TargetType="local:SvgIcon"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsBusy}" Value="True"/><Condition Binding="{Binding EffectiveMotion}" Value="True"/></MultiDataTrigger.Conditions><MultiDataTrigger.EnterActions><BeginStoryboard x:Name="Spin"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions><MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Spin"/></MultiDataTrigger.ExitActions></MultiDataTrigger></Style.Triggers></Style></local:SvgIcon.Style></local:SvgIcon><TextBlock Text="Working..." VerticalAlignment="Center"/><Button Content="Cancel sign-in" Command="{Binding CancelLoginCommand}" Style="{StaticResource QuietButton}" Padding="8,2" MinHeight="22" Margin="8,0,0,0"/></StackPanel></Border>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="20,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><local:SvgIcon NameKey="shield" Width="12" Height="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Encrypted on this PC" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="6,0,0,0"/></StackPanel><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Status}" Margin="0,0,16,0"/></DockPanel></Border>
 </Grid></Border>
</Window>