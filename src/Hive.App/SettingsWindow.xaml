<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hive.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" x:Class="Hive.App.SettingsWindow" Title="Hive Settings" Width="930" Height="730" MinWidth="880" MinHeight="680" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" local:Motion.Enabled="{Binding EffectiveMotion}">


    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>


    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Nav" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Nav" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                <Setter TargetName="Nav" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Nav" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition/>
            </Grid.RowDefinitions>


            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,0,10,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseSettings" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close settings">
                        <local:SvgIcon NameKey="close" Width="16" Height="16"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:SvgIcon NameKey="hex" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Hive" FontWeight="SemiBold" Margin="7,0,0,0"/>

                        <TextBlock Text="Preferences" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>


            <TabControl SelectionChanged="AnimatePage" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" Grid.Row="1" TabStripPlacement="Left" BorderThickness="0" Background="Transparent">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="65"/>
                                        <RowDefinition/>
                                        <RowDefinition Height="65"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Settings" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15" FontWeight="SemiBold" Margin="22,25,0,0"/>
                                    <ItemsPresenter Grid.Row="1"/>
                                    <StackPanel Grid.Row="2" Margin="22,0,16,20" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <local:SvgIcon NameKey="check" Width="12" Height="12" Foreground="{DynamicResource GreenBrush}"/>
                                            <TextBlock Text="{Binding PreferencesStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="6,0,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:SvgIcon NameKey="palette" Width="16" Height="16"/>
                            <TextBlock Text="Appearance" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="30,25,32,24">
                            <TextBlock Text="Appearance" FontSize="27" FontWeight="SemiBold"/>
                            <TextBlock Text="A workspace that feels like yours." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,22"/>
                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="14" Padding="26,18" Margin="0,0,0,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">


                                <Grid Height="133">
                                    <local:HoneycombBackdrop Width="250" Height="140" HorizontalAlignment="Right" Opacity="0.35" IsHitTestVisible="False"/>


                                    <Border Width="390" HorizontalAlignment="Center" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#1B2335" Opacity="0.12" BlurRadius="20" ShadowDepth="6"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="31"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="11,0">
                                                <DockPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <local:SvgIcon NameKey="hex" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="Hive" FontSize="10" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Ellipse Width="4" Height="4" Fill="{DynamicResource LineBrush}" Margin="0,0,4,0"/>
                                                        <Ellipse Width="4" Height="4" Fill="{DynamicResource LineBrush}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <Grid Grid.Row="1" Margin="11,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="88"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <DockPanel Margin="0,0,0,7">
                                                        <TextBlock Text="Your accounts" FontSize="10" FontWeight="SemiBold"/>
                                                        <Border HorizontalAlignment="Right" Width="47" Height="15" CornerRadius="4" Background="{DynamicResource PrimaryBrush}">
                                                            <TextBlock Text="+ Add" FontSize="8" Foreground="{DynamicResource AccentInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DockPanel>
                                                    <Border Background="{DynamicResource SelectedBrush}" CornerRadius="4" Padding="6,5">
                                                        <DockPanel>
                                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource GreenBrush}" Margin="0,0,5,0"/>
                                                            <TextBlock Text="HoneyExplorer" FontSize="8" FontWeight="SemiBold"/>
                                                            <TextBlock Text="••••••" Foreground="{DynamicResource GreenBrush}" FontSize="8" HorizontalAlignment="Right"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <Grid Height="17" Margin="6,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Height="3" Width="72" Background="{DynamicResource LineBrush}" HorizontalAlignment="Left" CornerRadius="1"/>
                                                        <Border Grid.Column="1" Height="3" Width="40" Background="{DynamicResource LineBrush}" HorizontalAlignment="Left" CornerRadius="1"/>
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource InputBrush}" CornerRadius="5" Padding="8">
                                                    <StackPanel>
                                                        <local:SvgIcon NameKey="user" Width="13" Height="13" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}"/>
                                                        <Border Height="3" Background="{DynamicResource LineBrush}" Margin="0,8,0,0" CornerRadius="1"/>
                                                        <Border Height="3" Background="{DynamicResource LineBrush}" Margin="0,5,15,0" CornerRadius="1"/>
                                                        <Border Height="12" Background="{DynamicResource PrimaryBrush}" Margin="0,10,0,0" CornerRadius="3"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>


                                </Grid>
                            </Border>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,15">
                                <DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Color theme" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="Choose the surface of your workspace." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource SubtleBrush}" Padding="3" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Tag="Light" Click="SelectTheme" Padding="16,6" MinHeight="30">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DarkTheme}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="Light"/>
                                                    </Button>
                                                    <Button Tag="Dusk" Click="SelectTheme" Padding="16,6" MinHeight="30">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DarkTheme}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="Dusk"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </ContentControl>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,15">
                                <DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Accent color" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="Highlights, selection and primary actions." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Tag="Honey" Click="SelectAccent" ToolTip="Honey" AutomationProperties.Name="Honey accent" Width="33" Height="33" MinHeight="0" Padding="4" Margin="6,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Accent}" Value="Honey">
                                                                    <Setter Property="BorderBrush" Value="#E9B34B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Ellipse Fill="#E9B34B" Width="23" Height="23"/>
                                                        <local:SvgIcon NameKey="check" Width="12" Height="12" Foreground="White">
                                                            <local:SvgIcon.Style>
                                                                <Style TargetType="local:SvgIcon">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Accent}" Value="Honey">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </local:SvgIcon.Style>
                                                        </local:SvgIcon>
                                                    </Grid>
                                                </Button>
                                                <Button Tag="Iris" Click="SelectAccent" ToolTip="Iris" AutomationProperties.Name="Iris accent" Width="33" Height="33" MinHeight="0" Padding="4" Margin="6,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Accent}" Value="Iris">
                                                                    <Setter Property="BorderBrush" Value="#9575D9"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Ellipse Fill="#9575D9" Width="23" Height="23"/>
                                                        <local:SvgIcon NameKey="check" Width="12" Height="12" Foreground="White">
                                                            <local:SvgIcon.Style>
                                                                <Style TargetType="local:SvgIcon">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Accent}" Value="Iris">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </local:SvgIcon.Style>
                                                        </local:SvgIcon>
                                                    </Grid>
                                                </Button>
                                                <Button Tag="Ocean" Click="SelectAccent" ToolTip="Ocean" AutomationProperties.Name="Ocean accent" Width="33" Height="33" MinHeight="0" Padding="4" Margin="6,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Accent}" Value="Ocean">
                                                                    <Setter Property="BorderBrush" Value="#42A2AE"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Ellipse Fill="#42A2AE" Width="23" Height="23"/>
                                                        <local:SvgIcon NameKey="check" Width="12" Height="12" Foreground="White">
                                                            <local:SvgIcon.Style>
                                                                <Style TargetType="local:SvgIcon">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Accent}" Value="Ocean">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </local:SvgIcon.Style>
                                                        </local:SvgIcon>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </ContentControl>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,15">
                                <DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Interface motion" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="Subtle transitions and button feedback." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding AnimationsEnabled}" Width="48" AutomationProperties.Name="AnimationsEnabled"/>
                                        </ContentControl>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,15">
                                <DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Compact layout" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="Smaller rows for larger account libraries." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding CompactRows}" Width="48" AutomationProperties.Name="CompactRows"/>
                                        </ContentControl>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:SvgIcon NameKey="shield" Width="16" Height="16"/>
                            <TextBlock Text="Privacy" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="30,25,32,24">
                            <TextBlock Text="Privacy" FontSize="27" FontWeight="SemiBold"/>
                            <TextBlock Text="Keep access to your accounts under your control." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,22"/>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,15">
                                <DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Reveal saved passwords" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="Show passwords in the account table." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding ShowPasswords}" Width="48" AutomationProperties.Name="ShowPasswords"/>
                                        </ContentControl>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="12" Padding="20" Margin="0,25,0,0">
                                <StackPanel>
                                    <local:SvgIcon NameKey="shield" Width="24" Height="24" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Only on this device" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                    <TextBlock Text="Passwords and session cookies are encrypted for your Windows profile. Hive does not send them to a separate backend." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="A browser sign-in saves the session only. Passwords are saved when you enter them explicitly in Account details." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:SvgIcon NameKey="refresh" Width="16" Height="16"/>
                            <TextBlock Text="Sessions" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="30,25,32,24">
                            <TextBlock Text="Sessions" FontSize="27" FontWeight="SemiBold"/>
                            <TextBlock Text="Keep saved access healthy without getting in your way." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,22"/>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,15">
                                <DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Automatic checks" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="Verify saved sessions while Hive is open." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding AutoCheckSessions}" Width="48" AutomationProperties.Name="AutoCheckSessions"/>
                                        </ContentControl>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,15">
                                <DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Automatic renewal" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="Refresh eligible cookies before access expires." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding AutoRenewSessions}" Width="48" AutomationProperties.Name="AutoRenewSessions"/>
                                        </ContentControl>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,15">
                                <DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Check frequency" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="Applies when automatic checks are enabled." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="11,7">
                                                <TextBlock Text="Every 5 minutes" FontSize="11"/>
                                            </Border>
                                        </ContentControl>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <StackPanel Margin="0,25,0,0">
                                <TextBlock Text="When Roblox needs you" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="An expired session turns red. Use Sign in again to complete any verification requested by Roblox. A temporary network error keeps the previous status." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                <TextBlock Text="Hive never changes your Roblox password automatically." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:SvgIcon NameKey="browser" Width="16" Height="16"/>
                            <TextBlock Text="Browser" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="30,25,32,24">
                            <TextBlock Text="Browser" FontSize="27" FontWeight="SemiBold"/>
                            <TextBlock Text="A separate, private browser context for every account." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,22"/>
                            <TextBlock Text="Browser executable" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Text="Leave empty to find an installed Chrome or Edge automatically." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,13"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BrowserPath,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Browser executable path" Height="37"/>
                                <Button Grid.Column="1" Click="ChooseBrowser" Content="Browse..." Margin="8,0,0,0"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,25,0,0"/>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,15">
                                <DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="Local files" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="Accounts, preferences and diagnostic logs." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="Open folder" Click="OpenDataFolder"/>
                                        </ContentControl>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border Background="{DynamicResource SubtleBrush}" Padding="20" CornerRadius="12" Margin="0,25,0,0">
                                <StackPanel>
                                    <TextBlock Text="Your sign-in stays separate" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Hive restores a saved session into a private context. Roblox sign-in and two-step verification happen on the normal Roblox website." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
