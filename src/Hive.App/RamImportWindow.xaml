<Window Style="{StaticResource {x:Type Window}}" x:Class="Hive.App.RamImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Import from RAM" Width="700" Height="470" MinWidth="600" MinHeight="400" WindowStartupLocation="CenterOwner">
 <Grid Background="{DynamicResource CanvasBrush}" Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Review your import" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
  <ListView Grid.Row="1" ItemsSource="{Binding Rows}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource LineBrush}"><ListView.View><GridView><GridViewColumn Header="Account" DisplayMemberBinding="{Binding Username}" Width="160"/><GridViewColumn Header="Alias" DisplayMemberBinding="{Binding Alias}" Width="130"/><GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="280"/></GridView></ListView.View></ListView>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><Button DockPanel.Dock="Right" Content="Import accounts" Style="{StaticResource PrimaryButton}" Click="Confirm"/><Button DockPanel.Dock="Right" Content="Cancel" Margin="0,0,8,0" IsCancel="True"/><TextBlock Text="Existing accounts are skipped." Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
