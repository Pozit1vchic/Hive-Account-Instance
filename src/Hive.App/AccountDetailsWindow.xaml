<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Hive.App.AccountDetailsWindow" Style="{StaticResource {x:Type Window}}" Title="Account details" Width="500" Height="600" MinWidth="460" MinHeight="520" WindowStartupLocation="CenterOwner" xmlns:local="clr-namespace:Hive.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" WindowStyle="None">

<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome><Border xmlns:local="clr-namespace:Hive.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,0,8,0"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseDialog" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close dialog"><local:SvgIcon NameKey="close" Width="15" Height="15"/></Button><TextBlock Text="Hive" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel></Border><Grid Background="{DynamicResource SurfaceBrush}" Margin="20" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="{Binding EditorTitle}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding SessionLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}"><Label Content="Description"/><TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" MaxLength="4000" VerticalScrollBarVisibility="Auto"/>
   <Expander Header="Password and session tools" Margin="0,20,0,0"><StackPanel Margin="0,12,0,0"><Label Content="Replace saved password (optional)"/><PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged" MaxLength="5000"/><Button Content="Sign in again" Command="{Binding SignInCommand}" Margin="0,12,0,0"/><Label Content="Session cookie" Margin="0,12,0,0"/><PasswordBox x:Name="CookieInput" PasswordChanged="CookieChanged"/><Button Content="Verify and save cookie" Command="{Binding ImportCookieCommand}" Margin="0,8,0,12"/><Label Content="RobloxPlayerBeta process ID"/><TextBox Text="{Binding ProcessId,UpdateSourceTrigger=PropertyChanged}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Link PID" Command="{Binding AttachCommand}" Margin="0,0,8,0"/><Button Content="Unlink" Command="{Binding DetachCommand}"/></StackPanel></StackPanel></Expander>
   <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Close" IsCancel="True" Margin="0,0,8,0"/><Button Content="Save changes" Click="Save" Style="{StaticResource PrimaryButton}"/></StackPanel>
 </Grid></Grid></Border></Window>
