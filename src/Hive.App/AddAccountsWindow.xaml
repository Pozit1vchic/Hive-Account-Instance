<?xml version="1.0" ?><Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Hive.App.AddAccountsWindow" Style="{StaticResource {x:Type Window}}" Title="Add accounts" Width="520" Height="490" MinWidth="460" MinHeight="430" WindowStartupLocation="CenterOwner" xmlns:local="clr-namespace:Hive.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" WindowStyle="None">

<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome><Border xmlns:local="clr-namespace:Hive.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,0,8,0"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseDialog" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close dialog"><local:SvgIcon NameKey="close" Width="15" Height="15"/></Button><TextBlock Text="Hive" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel></Border><Grid Background="{DynamicResource SurfaceBrush}" Margin="20" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="Hint" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel>
  <ScrollViewer x:Name="InputPanels" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <StackPanel x:Name="ManualPanel"><TextBlock Text="Complete sign-in and any Roblox verification in the browser window. This dialog stays open until your account is saved." TextWrapping="Wrap"/></StackPanel>
   <StackPanel x:Name="CredentialsPanel"><Label Content="Username"/><TextBox x:Name="UsernameInput" MaxLength="64" Margin="0,0,0,14"/><Label Content="Password"/><PasswordBox x:Name="PasswordInput" MaxLength="5000"/><Expander Header="Multiple accounts" Margin="0,18,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="One username:password per line. Accounts open one at a time." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBox x:Name="BulkInput" AcceptsReturn="True" Height="130" VerticalScrollBarVisibility="Auto" MaxLength="260000"/></StackPanel></Expander></StackPanel>
   <StackPanel x:Name="CookiesPanel"><Label Content="Session cookies"/><TextBox x:Name="CookiesInput" AcceptsReturn="True" Height="220" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MaxLength="850000"/></StackPanel>
   <StackPanel x:Name="CustomPanel"><Label Content="Start URL"/><TextBox x:Name="UrlInput" Text="https://www.roblox.com/login" Margin="0,0,0,14"/><Label Content="JavaScript (optional)"/><TextBox x:Name="ScriptInput" AcceptsReturn="True" Height="170" MaxLength="32768" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></StackPanel>
  </StackPanel></ScrollViewer>
  <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="CancelButton" Content="Cancel" Click="CloseDialog" Margin="0,0,8,0"/><Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource PrimaryButton}" Click="Continue" IsDefault="True"/></StackPanel>
 </Grid></Grid></Border></Window>
